<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏆 LEADERBOARD"
        android:textColor="#FFD700"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTabGlobal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:gravity="center"
            
            android:layout_marginEnd="4dp"
            android:text="Global"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_accent"
        android:backgroundTint="@null"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTabCountry"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:maxLines="3"
            android:gravity="center"
            
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="My Country"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_accent"
        android:backgroundTint="@null"/>

        <TextView
            android:id="@+id/btnTabCategory"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:maxLines="4"
            android:gravity="center"
            android:layout_marginStart="4dp"
            android:text="Category"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_accent"
        android:backgroundTint="@null"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
        android:textColor="@color/gold"
            android:layout_width="260dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="80dp"
            app:backgroundTint="#1A1F3D"
            app:strokeColor="#FFD700"
            
            app:cornerRadius="12dp"
            app:rippleColor="#66FFD700"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:text="← BACK"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0.06"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

</LinearLayout>