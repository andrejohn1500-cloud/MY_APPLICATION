<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 MY STORY"
            android:textColor="@color/gold"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A personal message from the creator of Dres Quiz"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="48dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewStory"
            android:layout_width="260dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            app:backgroundTint="#1A1F3D"
            app:strokeColor="#FFD700"
            app:strokeWidth="1.5dp"
            app:cornerRadius="12dp"
            app:rippleColor="#66FFD700"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:text="📖 READ MY STORY"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0.06"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackStory"
            android:layout_width="260dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            app:backgroundTint="#1A1F3D"
            app:strokeColor="#FFD700"
            app:strokeWidth="1.5dp"
            app:cornerRadius="12dp"
            app:rippleColor="#66FFD700"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:text="← BACK"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0.06"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

    </LinearLayout>
</ScrollView>
